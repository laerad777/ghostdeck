#!/bin/bash
# Finder launches this with no terminal, so a failure has to be shown, not printed: before this, a
# missing venv or pyobjc exited 2 with the reason on a stderr nobody could see, and the icon just
# bounced and vanished.
ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
export PATH="/opt/homebrew/bin:${HOME}/Library/Android/sdk/platform-tools:${PATH}"
export PYTHONPATH="${ROOT}/src"
LOG="${HOME}/.ghostdeck/gui.log"

fail() {
  # The message travels through the environment, so quotes in it cannot break the AppleScript.
  GHOSTDECK_ALERT="$1" osascript \
    -e 'display alert "ghostdeck을 열지 못했습니다" message (system attribute "GHOSTDECK_ALERT") as critical' \
    >/dev/null 2>&1
  exit 1
}

cd "$ROOT" || fail "체크아웃을 찾지 못했습니다: ${ROOT}"
mkdir -p "${HOME}/.ghostdeck" || fail "${HOME}/.ghostdeck을 만들지 못했습니다."
PY="${HOME}/.ghostdeck/venv/bin/python"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3)"
fi
[ -n "$PY" ] || fail "python3을 찾지 못했습니다. ~/.ghostdeck/venv를 만드십시오."

# The window needs pyobjc; check it here, where a failure can still be shown, because `exec` below
# hands this process to Python and nothing after it runs.
if ! reason="$("$PY" -c 'import AppKit, WebKit, MediaPlayer, ghostdeck.app' 2>&1)"; then
  fail "${PY}: $(printf '%s\n' "$reason" | tail -n 1)
pip install -e \".[device,gui]\" 을 실행하십시오."
fi

# exec keeps this bundle as the one process macOS sees, so the Dock shows one ghostdeck icon.
exec "$PY" -m ghostdeck gui 2>>"$LOG"
